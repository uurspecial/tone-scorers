# Load these values into the process environment; never commit your real key.
SCORER_API_KEY=replace-with-a-random-api-key
SCORER_DEVICE=auto
# Optional: Hugging Face cache, base-model download token, adapter location.
# HF_HUB_CACHE=/path/to/huggingface/hub
# HF_TOKEN=
# SCORER_ADAPTER_DIR=/path/to/adapters
